# Database (Docker default from docker-compose.yml)
DATABASE_URL="postgresql://user:password@localhost:55432/js_ashanti_db"

# Server Configuration
PORT=4001

# AI (Groq)
GROQ_API_KEY=""

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend)
RESEND_API_KEY=""

# Authentication (Better-Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4001"
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated origins for Expo on a device/LAN (e.g. http://192.168.1.5:8081)
BETTER_AUTH_ADDITIONAL_ORIGINS=""
ADMIN_ID="" # ID of the first admin account

# Social Authentication (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NODE_ENV="development"
