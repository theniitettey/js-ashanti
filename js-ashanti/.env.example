# Backend API URL – must be reachable from the app.
# iOS Simulator: localhost works (e.g. http://localhost:4001).
# Physical device / Android emulator: use your machine's LAN IP and backend port.
#   macOS/Linux: run 'ifconfig' or 'ip addr' to find your IP.
#   Windows: run 'ipconfig' for IPv4 address.
# Example for device: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4001
EXPO_PUBLIC_API_BASE_URL=http://localhost:4001
EXPO_PUBLIC_API_AUTH_LOGIN=/api/auth/sign-in/email
EXPO_PUBLIC_API_AUTH_LOGOUT=/api/auth/sign-out
EXPO_PUBLIC_API_AUTH_SESSION=/api/auth/get-session
