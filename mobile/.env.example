# Backend API URL – must be reachable from the app.
# iOS Simulator: localhost works (e.g. http://localhost:4001).
# Physical device / Android emulator: with Expo LAN mode in __DEV__, the app guesses your
# machine IP from Metro (`expoConfig.hostUri`). Override if login fails or you use
# `expo start --tunnel` (set http://YOUR_LAN_IP:4001 or an HTTPS tunnel).
# Helpful commands: macOS `ipconfig getifaddr en0`, Linux `ip addr`, Windows `ipconfig`.
# Example override: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:4001
EXPO_PUBLIC_API_BASE_URL=http://localhost:4001
EXPO_PUBLIC_API_AUTH_LOGIN=/api/auth/sign-in/email
EXPO_PUBLIC_API_AUTH_LOGOUT=/api/auth/sign-out
EXPO_PUBLIC_API_AUTH_SESSION=/api/auth/get-session
